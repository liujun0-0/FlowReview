{
  "name": "@liujun0-0/flowreview",
  "version": "0.0.3-dev.0",
  "type": "module",
  "description": "Read code changes along complete functional flows, with method graphs, source snapshots and review explanations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liujun0-0/FlowReview.git"
  },
  "bugs": {
    "url": "https://github.com/liujun0-0/FlowReview/issues"
  },
  "homepage": "https://github.com/liujun0-0/FlowReview#readme",
  "keywords": [
    "diff",
    "git",
    "jj",
    "github",
    "pull-request",
    "viewer",
    "cli"
  ],
  "bin": {
    "flowreview": "./bin/flowreview.js",
    "yadiff": "./bin/yadiff.js",
    "yadiff-review": "./bin/yadiff-review.js"
  },
  "files": [
    "bin/",
    "lib/",
    "dist/",
    "THIRD-PARTY-LICENSES",
    "licenses/",
    "README.md",
    "open-review.cmd",
    "setup-review.cmd",
    "docs/custom-reader.md",
    "skills/",
    "tools/install_skill.py",
    "docs/getting-started.md",
    "docs/licensing.md",
    "LICENSE",
    "UPSTREAM.md",
    "docs/architecture.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "prepack": "npm run build",
    "review": "node ./bin/flowreview.js",
    "test:review": "node --test test/review.test.js test/method-diff.test.js test/flow-graph.test.js test/method-metadata.test.js test/flow-layout.test.js test/business-flow.test.js test/sequence-model.test.js test/sequence-canvas.test.js test/elk-layout.test.js test/entrypoints.test.js test/source-viewer.test.js test/reading-state.test.js",
    "test:skill": "python -B test/test_skill_install.py",
    "dev:legacy": "node ./bin/yadiff.js --dev"
  },
  "dependencies": {
    "@pierre/diffs": "^1.2.7",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "express": "^5.2.0",
    "java-parser": "3.0.1"
  },
  "devDependencies": {
    "@pierre/trees": "^1.0.0-beta.4",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "contributors": [
    {
      "name": "FlowReview contributors"
    },
    {
      "name": "baggiiiie",
      "url": "https://github.com/baggiiiie"
    }
  ]
}
